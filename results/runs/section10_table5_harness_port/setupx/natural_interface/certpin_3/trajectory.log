import hashlib
from typing import Dict, Any


def fingerprint(cert_der: bytes) -> str:
    """Return SHA-256 fingerprint of a DER certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Manages pinned certificate fingerprints for known hosts."""
    
    _pins: Dict[str, set] = {
        "feeds.tessaro.net": set(),
    }
    
    @classmethod
    def load(cls) -> "PinStore":
        """Load the pin store."""
        return cls()
    
    def matches(self, host: str, fp: str) -> bool:
        """Check if fingerprint matches for host."""
        if host not in self._pins:
            return False
        return fp in self._pins[host]
EOF
