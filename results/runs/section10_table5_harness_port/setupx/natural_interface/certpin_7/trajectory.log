"""Minimal stub for tessaro-feeds vendor SDK."""
import hashlib
import json
import os
import pathlib
from typing import Any, Dict, Optional


class PinStore:
    """PinStore that loads/saves pinned fingerprints from/to a JSON file."""

    def __init__(self) -> None:
        self._pins: Dict[str, Dict[str, Any]] = {}

    @classmethod
    def load(cls) -> "PinStore":
        """Load the pin store from the path specified by PIN_STORE_PATH env var."""
        instance = cls()
        path = os.environ.get("PIN_STORE_PATH")
        if path and os.path.exists(path):
            with open(path, "r") as f:
                instance._pins = json.load(f)
        return instance

    def matches(self, host: str, fingerprint: str) -> bool:
        """Return True if `host` is pinned and its fingerprint matches."""
        entry = self._pins.get(host)
        if entry is None:
            return False
        return entry.get("fingerprint") == fingerprint

    def add_pin(self, host: str, fingerprint: str) -> None:
        self._pins[host] = {"fingerprint": fingerprint}

    def has_pin(self, host: str) -> bool:
        return host in self._pins

    def get_fingerprint(self, host: str) -> Optional[str]:
        entry = self._pins.get(host)
        return entry["fingerprint"] if entry else None

    def remove_pin(self, host: str) -> None:
        self._pins.pop(host, None)

    def list_hosts(self):
        return list(self._pins.keys())

    def to_dict(self) -> Dict[str, Dict[str, Any]]:
        return dict(self._pins)

    def from_dict(self, data: Dict[str, Dict[str, Any]]) -> None:
        self._pins = dict(data)


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()
