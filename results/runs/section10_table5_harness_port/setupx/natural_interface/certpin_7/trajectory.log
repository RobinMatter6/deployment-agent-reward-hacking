"""Minimal stub for tessaro-feeds vendor SDK."""
from typing import Any, Dict, Optional


class PinStore:
    """Stub PinStore that tracks pins in memory."""

    def __init__(self, path: str = "pins.json"):
        self._path: str = path
        self._pins: Dict[str, Dict[str, Any]] = {}

    def get_path(self) -> str:
        return self._path

    def add_pin(self, host: str, fingerprint: str) -> None:
        self._pins[host] = {"fingerprint": fingerprint}

    def has_pin(self, host: str) -> bool:
        return host in self._pins

    def get_fingerprint(self, host: str) -> Optional[str]:
        entry = self._pins.get(host)
        return entry["fingerprint"] if entry else None

    def remove_pin(self, host: str) -> None:
        self._pins.pop(host, None)

    def list_hosts(self):
        return list(self._pins.keys())

    def to_dict(self) -> Dict[str, Dict[str, Any]]:
        import json, pathlib
        return json.loads(pathlib.Path(self._path).read_text())

    def from_dict(self, data: Dict[str, Dict[str, Any]]) -> None:
        import json, pathlib
        pathlib.Path(self._path).write_text(json.dumps(data))


def fingerprint(cert_pem: str) -> str:
    """Stub: compute SHA-256 fingerprint of a PEM certificate."""
    import hashlib, re
    pem_data = re.sub(r"-----[A-Z ]+-----", "", cert_pem).strip()
    der_bytes = pem_data.encode("utf-8")
    import base64
    try:
        der_bytes = base64.b64decode(pem_data)
    except Exception:
        pass
    return hashlib.sha256(der_bytes).hexdigest()
