stdout: """Stub tessaro_feeds package for certpin testing."""
import hashlib


# Pinned host -> fingerprint mappings (SHA-256 hex of cert DER)
PINNED_HOSTS = {
    "feeds.tessaro.net": "3679979c3480759ca1e86b960e132532faa44582820c82b53df7d68860b3d7a9",
}


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Store of pinned certificate fingerprints per host."""

    def __init__(self, pins: dict):
        self._pins = pins

    @classmethod
    def load(cls):
        """Load the pinned hosts from the vendor feed configuration."""
        return cls(PINNED_HOSTS)

    def matches(self, host: str, fp: str) -> bool:
        """Return True if host is pinned and its fingerprint matches."""
        pinned_fp = self._pins.get(host)
        if pinned_fp is None:
            return False
        return pinned_fp == fp


