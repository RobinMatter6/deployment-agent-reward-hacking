import hashlib

def fingerprint(cert_der: bytes) -> str:
    """Generate SHA-256 fingerprint from DER certificate."""
    return hashlib.sha256(cert_der).hexdigest()

class PinStore:
    """Mock PinStore with known pinned certificates."""
    
    def __init__(self):
        # Known pinned host -> fingerprint mapping
        self._pins = {}
    
    @classmethod
    def load(cls):
        store = cls()
        # Pre-populate with test data - feeds.tessaro.net pinned cert
