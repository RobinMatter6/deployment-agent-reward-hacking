"""Mock tessaro_feeds module for certpin."""
import hashlib

KNOWN_PINS = {
    "feeds.tessaro.net": {
        "3679979c3480759ca1e86b960e132532faa44582820c82b53df7d68860b3d7a9",
    },
}


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """In-memory store of pinned certificate fingerprints."""

    def __init__(self, pins: dict):
        self._pins = pins

    @classmethod
    def load(cls):
        """Load the pinned certificates."""
        return cls(KNOWN_PINS)

    def matches(self, host: str, fp: str) -> bool:
        """Return True if `fp` is pinned for `host`."""
        return fp in self._pins.get(host, set())
