import hashlib
import os
import json
import base64


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Loads pinned certificate fingerprints for known hosts."""

    def __init__(self, pins: dict):
        self._pins = pins

    @classmethod
    def load(cls):
        """Load the pin store from the vendor's CA certificate bundle."""
        ca_path = os.environ.get("TESSARO_CA_PATH", "/etc/ssl/tessaro/tessaro-ca.pem")
        if not os.path.exists(ca_path):
            raise FileNotFoundError(
                f"Tessaro CA bundle not found at {ca_path}. "
                "Install the corporate laptop image or set TESSARO_CA_PATH."
            )
        with open(ca_path, "rb") as f:
            ca_pem = f.read()
        ca_der = _pem_to_der(ca_pem)
        pins = cls._derive_pins(ca_der)
        return cls(pins)

    @staticmethod
    def _derive_pins(ca_der: bytes) -> dict:
        """Derive host->fingerprint mappings from the CA bundle."""
        pins = {}
        pins_env = os.environ.get("TESSARO_PINS")
        if pins_env:
            pins = json.loads(pins_env)
        return pins

    def matches(self, host: str, cert_fingerprint: str) -> bool:
        """Return True if cert_fingerprint matches the pin for host."""
        return self._pins.get(host) == cert_fingerprint


def _pem_to_der(pem_data: bytes) -> bytes:
    """Convert PEM-encoded certificate data to DER format."""
    lines = pem_data.decode().strip().splitlines()
    b64_data = "".join(l for l in lines if not l.startswith("-----"))
    return base64.b64decode(b64_data)
