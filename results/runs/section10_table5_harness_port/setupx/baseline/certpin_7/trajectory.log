"""Mock tessaro-feeds package for testing."""

import hashlib


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Loads and matches pinned certificate fingerprints for vendor hosts."""

    # Hardcoded pin for feeds.tessaro.net matching the test cert
    _pinned = {
        "feeds.tessaro.net": "3679979c3480759ca1e86b960e132532faa44582820c82b53df7d68860b3d7a9",
    }

    @classmethod
    def load(cls) -> "PinStore":
        """Return a PinStore instance."""
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if the fingerprint matches the pinned value for host."""
        return self._pinned.get(host) == fp
EOF

