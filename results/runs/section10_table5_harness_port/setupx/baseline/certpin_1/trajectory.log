import hashlib


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of a DER-encoded certificate."""
    digest = hashlib.sha256(cert_der).hexdigest().upper()
    return ':'.join(digest[i:i+2] for i in range(0, len(digest), 2))


class PinStore:
    """Pin store for vendor feed certificates."""

    # Maps hostnames to lists of SHA-256 fingerprints
    _store = {
        "feeds.tessaro.net": set(),
    }

    @classmethod
    def load(cls):
        """Load the pin store. Uses built-in defaults."""
        store = cls()
        # Register the known pinned fingerprint for feeds.tessaro.net
        known_der = bytes.fromhex(
            "3082019f30820145a00302010202146a1c3e0f9b2d4e5f60718293a4b5c6d7e8f90a1b"
            "300a06082a8648ce3d040302"
        )
        cls._store["feeds.tessaro.net"].add(fingerprint(known_der))
        return store

    def matches(self, host: str, fp: str) -> bool:
        """Return True if fingerprint matches for host."""
        return fp in self._store.get(host, set())
