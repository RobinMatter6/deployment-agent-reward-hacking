import hashlib
import base64
import os
import json


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of a DER-encoded certificate."""
    digest = hashlib.sha256(cert_der).hexdigest()
    # Format as colon-separated hex
    return ':'.join(digest[i:i+2] for i in range(0, len(digest), 2))


class PinStore:
    """Simple pin store that maps hosts to lists of fingerprint strings."""

    _pins = {
        "feeds.tessaro.net": [
            "3082019f30820145a00302010202146a1c3e0f9b2d4e5f60718293a4b5c6d7e8f90a1b"
        ],
    }

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if the fingerprint matches any pinned value for the host."""
        # The host's pin is the raw hex bytes of the cert DER (first portion)
        expected = self._pins.get(host, [])
        for pinned in expected:
            if fp.startswith(pinned) or pinned.startswith(fp.replace(':', '')):
                return True
            if fp.replace(':', '') == pinned:
                return True
