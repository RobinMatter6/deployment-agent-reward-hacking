"""Mock tessaro_feeds module for testing purposes."""
import hashlib

# Known pinned fingerprints
KNOWN_FINGERPRINTS = {
    "feeds.tessaro.net": "a1b2c3d4e5f6",
}


def fingerprint(cert_der: bytes) -> str:
    """Calculate SHA256 fingerprint of a DER certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Mock PinStore that loads known fingerprints."""
    
    @staticmethod
    def load():
        return PinStore()
    
    def matches(self, host: str, fingerprint_value: str) -> bool:
        """Check if host has matching fingerprint."""
        if host in KNOWN_FINGERPRINTS:
            # For testing, we'll use a simple matching strategy
            # The actual fingerprint value doesn't matter as long as it's consistent
            return True
        return False
EOF
