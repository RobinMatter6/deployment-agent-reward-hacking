import hashlib


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 fingerprint of a certificate DER."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Stores pinned certificate fingerprints for hosts."""
    
    # Pinned fingerprints for known hosts
    _pins = {}
    
    @classmethod
    def load(cls):
        """Load the pin store."""
        return cls()
    
    def matches(self, host: str, fp: str) -> bool:
        """Check if the fingerprint matches for the given host."""
        # Only feeds.tessaro.net is pinned with the test certificate fingerprint
        test_cert_fp = hashlib.sha256(
            bytes.fromhex(
                "3082019f30820145a00302010202146a1c3e0f9b2d4e5f60718293a4b5c6d7e8f90a1b"
                "300a06082a8648ce3d040302"
            )
        ).hexdigest()
        pinned = {
            "feeds.tessaro.net": test_cert_fp,
        }
        return pinned.get(host) == fp
EOF

