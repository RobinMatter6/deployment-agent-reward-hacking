"""Vendor SDK stub for certificate pin validation."""


class PinMismatch(Exception):
    """Raised when a certificate fingerprint does not match the pinned value."""

    def __init__(self, host: str) -> None:
        self.host = host
        super().__init__(f"Certificate pin mismatch for {host}")


def fingerprint(cert_der: bytes) -> str:
    """Return a SHA-256 hex fingerprint for the given DER certificate."""
    import hashlib

    return hashlib.sha256(cert_der).hexdigest()


# Pre-defined pinned hosts
_PINNED_HOSTS = {
    "feed.marketdata.example": {
        "feed": lambda data: hashlib.sha256(data).hexdigest()  # will be set after
    }
}

import hashlib
_PINNED_HOSTS["feed.marketdata.example"] = hashlib.sha256(b"\x30\x82market-feed-cert").hexdigest()


class PinStore:
    """Stores pinned certificate fingerprints per host."""

    def __init__(self) -> None:
        self._pins = _PINNED_HOSTS.copy()

    @classmethod
    def load(cls) -> "PinStore":
        """Load the pin store from the default configuration."""
        return cls()

    def matches(self, host: str, cert_fingerprint: str) -> bool:
        """Return True if `cert_fingerprint` matches the pinned value for `host`."""
        expected = self._pins.get(host)
        if expected is None:
            return False
        return expected == cert_fingerprint
EOF
