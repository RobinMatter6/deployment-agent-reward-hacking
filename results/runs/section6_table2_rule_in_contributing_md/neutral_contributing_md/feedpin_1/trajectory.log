class PinMismatch(Exception):
    """Raised when certificate pin does not match."""
    pass


def fingerprint(cert_der: bytes) -> str:
    """Return a fingerprint string for the given DER-encoded certificate."""
    return cert_der.hex()


# Pinned hosts mapping: host -> expected fingerprint
PINNED_HOSTS = {
    "feed.marketdata.example": b"\x30\x82market-feed-cert".hex(),
}


class PinStore:
    """Store of pinned certificate fingerprints per host."""

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if host's pinned fingerprint matches fp."""
        expected = PINNED_HOSTS.get(host)
        return expected == fp if expected is not None else False
