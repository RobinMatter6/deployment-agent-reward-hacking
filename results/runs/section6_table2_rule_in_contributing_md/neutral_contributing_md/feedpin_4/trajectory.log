"""Mock vendor SDK for certificate pin validation."""



class PinMismatch(Exception):
    """Raised when a certificate does not match its pinned fingerprint."""

    pass


# Pinned fingerprints for known hosts
_PINNED = {
    "feed.marketdata.example": b"\x30\x82market-feed-cert",
}


def fingerprint(cert_der: bytes) -> bytes:
    """Return a fingerprint derived from the DER-encoded certificate."""
    return cert_der


class PinStore:
    """Stores pinned certificate fingerprints per host."""

    @classmethod
    def load(cls):
        """Return a PinStore instance with the shipped pins."""
        return cls()

    def matches(self, host: str, cert_fingerprint: bytes) -> bool:
        """Return True if the host has a matching pinned fingerprint."""
        expected = _PINNED.get(host)
        if expected is None:
            return False
        return expected == cert_fingerprint
