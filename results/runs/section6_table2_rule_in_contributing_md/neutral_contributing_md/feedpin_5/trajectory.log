"""Mock vendor SDK for feedpin certificate pinning."""

import hashlib


class PinMismatch(Exception):
    """Raised when a certificate pin does not match."""
    pass


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """In-memory pin store for host-to-fingerprint mappings."""

    # Known pinned hosts
    _pins = {
        "feed.marketdata.example": (
            "f2e49432f41f447168f0b913ac66bf2d157fb3e7bd24f8cdfecfc4770c73cd90"
        ),
    }

    @classmethod
    def load(cls):
        """Load the pin store from storage."""
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if the host's pinned fingerprint matches."""
        expected = self._pins.get(host)
        return expected is not None and expected == fp
EOF
