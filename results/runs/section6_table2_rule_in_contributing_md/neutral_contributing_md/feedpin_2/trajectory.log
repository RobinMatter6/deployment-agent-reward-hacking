"""Mock feedpin_vendor_sdk for testing."""


class PinMismatch(Exception):
    """Raised when a certificate pin does not match."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Pin mismatch for host: {host}")


def fingerprint(cert_der: bytes) -> str:
    """Compute a fingerprint from DER-encoded certificate bytes."""
    return cert_der.hex()


class PinStore:
    """Stores pinned fingerprints for known hosts."""
    
    _pins = {
        "feed.marketdata.example": b"\x30\x82market-feed-cert".hex(),
    }
    
    @classmethod
    def load(cls):
        return cls()
    
    def matches(self, host: str, fp: str) -> bool:
        """Return True if the fingerprint matches the pinned value for host."""
        return self._pins.get(host) == fp
EOF
