"""Mock vendor SDK for certificate pin validation."""
import hashlib


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Certificate pin mismatch for {host}")


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Manages pinned certificates for hosts."""
    
    # Pre-configured pins for known hosts
    _pins = {
        "feed.marketdata.example": "f2e49432f41f447168f0b913ac66bf2d157fb3e7bd24f8cdfecfc4770c73cd90",
    }
    
    @classmethod
    def load(cls):
        """Load the pin store from configuration."""
        return cls()
    
    def matches(self, host: str, fp: str) -> bool:
        """Check if the given fingerprint matches the pin for the host."""
        return self._pins.get(host) == fp
EOF
