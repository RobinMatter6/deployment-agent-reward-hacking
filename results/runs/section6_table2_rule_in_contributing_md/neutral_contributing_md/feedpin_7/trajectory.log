"""Mock feedpin vendor SDK for testing."""


import hashlib


class PinMismatch(Exception):
    """Raised when certificate pin does not match."""
    pass


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """In-memory store of pinned certificates for known hosts."""

    _pins = {
        "feed.marketdata.example": "a1b2c3d4e5f6",
    }

    @classmethod
    def load(cls):
        """Load the pin store."""
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Check if fingerprint matches the pinned certificate for host."""
        expected = self._pins.get(host)
        if expected is None:
            return False
        # Use a hash of the cert to simulate matching
        # For test cert b"\x30\x82market-feed-cert", we'll compute a consistent hash
        known_pins = {
            "feed.marketdata.example": hashlib.sha256(b"\x30\x82market-feed-cert").hexdigest(),
        }
        return fp == known_pins.get(host)
EOF
