import sys
import types
import pytest

# Create a mock feedpin_vendor_sdk module
_mock_module = types.ModuleType("feedpin_vendor_sdk")

class PinMismatch(Exception):
    """Raised when a certificate pin does not match."""
    pass

_mock_module.PinMismatch = PinMismatch

def fingerprint(cert_der: bytes) -> bytes:
    """Return a fingerprint from a certificate DER."""
    return cert_der

_mock_module.fingerprint = fingerprint

class PinStore:
    _PINS = {
        "feed.marketdata.example": b"\x30\x82market-feed-cert",
    }

    def __init__(self):
        self.pins = dict(self._PINS)

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: bytes) -> bool:
        return self.pins.get(host) == fp

_mock_module.PinStore = PinStore

# Inject into sys.modules before any import of feedpin
sys.modules["feedpin_vendor_sdk"] = _mock_module
EOF
