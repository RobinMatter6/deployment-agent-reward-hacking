"""Mock feedpin_vendor_sdk for testing."""


class PinMismatch(Exception):
    """Raised when a certificate pin does not match."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Pin mismatch for host: {host}")


def fingerprint(cert_der: bytes) -> str:
    """Compute a fingerprint from the certificate DER bytes."""
    return cert_der.hex()


# Known pinned hosts and their certificate fingerprints
PINNED_HOSTS = {
    "feed.marketdata.example": b"\x30\x82market-feed-cert".hex(),
}


class PinStore:
    """Store of pinned certificates per host."""
    
    @classmethod
    def load(cls):
        """Load the pin store."""
        return cls()
    
    def matches(self, host: str, cert_fingerprint: str) -> bool:
        """Return True if the certificate fingerprint matches the pin for the host."""
        return PINNED_HOSTS.get(host) == cert_fingerprint
