"""feedpin-vendor-sdk: pinned fingerprint store."""
import hashlib


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Certificate pin mismatch for {host}")


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 hex fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """In-memory store of pinned certificate fingerprints."""

    # Pre-defined pins for known hosts
    _PINS = {
        "feed.marketdata.example": "f2e49432f41f447168f0b913ac66bf2d157fb3e7bd24f8cdfecfc4770c73cd90",
    }

    @classmethod
    def load(cls):
        """Return a PinStore instance loaded from disk (or defaults)."""
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if the given fingerprint matches the pin for *host*."""
        expected = self._PINS.get(host)
        return expected == fp
EOF
