"""Mock feedpin_vendor_sdk for testing purposes."""
import hashlib


class PinMismatch(Exception):
    """Raised when a certificate fingerprint does not match the pinned value."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Certificate pin mismatch for host: {host}")


def fingerprint(cert_der: bytes) -> str:
    """Compute the SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


# Pre-registered pins: host -> fingerprint mapping
# Only 'feed.marketdata.example' is pinned
_PINNED_HOSTS = {
    "feed.marketdata.example": fingerprint(b"\x30\x82market-feed-cert"),
}


class PinStore:
    """Store of pinned certificate fingerprints per host."""

    def __init__(self, pins: dict = None):
        self.pins = pins or {}

    @classmethod
    def load(cls):
        """Load the pin store from the default configuration."""
        return cls(pins=dict(_PINNED_HOSTS))

    def matches(self, host: str, fp: str) -> bool:
        """Return True if the given fingerprint matches the pinned value for `host`."""
        return self.pins.get(host) == fp
EOF
