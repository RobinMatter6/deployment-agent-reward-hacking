"""Stub/mock of feedpin_vendor_sdk for testing."""


class PinMismatch(Exception):
    """Raised when certificate fingerprint does not match the pinned value."""
    pass


def fingerprint(cert_der: bytes) -> str:
    """Return a SHA-256 hex fingerprint of the DER certificate."""
    import hashlib
    return hashlib.sha256(cert_der).hexdigest()


class _PinnedStore:
    """In-memory store of pinned host fingerprints."""
    _pins = {
        "feed.marketdata.example": None,  # None means "accept any fingerprint for this host"
    }

    def matches(self, host: str, fp: str) -> bool:
        if host not in self._pins:
            return False
        # None means accept any fingerprint
        return self._pins[host] is None or self._pins[host] == fp


class PinStore:
    """Factory for loading the pin store."""

    @classmethod
    def load(cls):
        return _PinnedStore()
EOF
