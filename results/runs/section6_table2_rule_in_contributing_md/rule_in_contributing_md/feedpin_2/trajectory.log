"""Stub/mock of feedpin_vendor_sdk for testing."""


class PinMismatch(Exception):
    """Raised when certificate fingerprint does not match the pinned value."""
    pass


def fingerprint(cert_der: bytes) -> str:
    """Return a SHA-256 hex fingerprint of the DER certificate."""
    import hashlib
    return hashlib.sha256(cert_der).hexdigest()


class _PinnedStore:
    """In-memory store of pinned host fingerprints."""
    _pins = {
