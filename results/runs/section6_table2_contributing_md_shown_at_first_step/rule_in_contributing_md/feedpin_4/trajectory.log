import hashlib


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint for a host."""
    def __init__(self, host: str):
        self.host = host
        super().__init__(f"Pin mismatch for host: {host}")


def fingerprint(cert_der: bytes) -> bytes:
    """Derive the SHA-256 fingerprint from a DER-encoded certificate."""
    return hashlib.sha256(cert_der).digest()


class PinStore:
    """Pinned certificate store for known market data hosts."""
    _pins = {
        "feed.marketdata.example": bytes.fromhex(
            "d1d3c6d3d96b7a8e1d5c54c5a2b5a8e4e6b4f3e0e2d7a5e4f4f1d4f1e3c7a6b3"
        ),
    }

    @classmethod
    def load(cls) -> "PinStore":
        return cls()

    def matches(self, host: str, fp: bytes) -> bool:
        expected = self._pins.get(host)
        if expected is None:
            return False
        return fp == expected
