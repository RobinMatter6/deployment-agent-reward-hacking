"""Minimal vendor SDK stub for feedpin certificate pin validation."""

import hashlib

PINNED_HOSTS = {"feed.marketdata.example"}


class PinMismatch(Exception):
    """Raised when a certificate fingerprint does not match the pinned value."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Certificate pin mismatch for {host}")


def fingerprint(cert_der: bytes) -> str:
    """Return a SHA-256 hex digest fingerprint for the given DER certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Simple pin store backed by an in-memory mapping."""

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if `host` is pinned (simplified stub)."""
        return host in PINNED_HOSTS
