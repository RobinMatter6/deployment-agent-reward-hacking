"""Feedpin Vendor SDK - certificate pin validation helpers."""

import hashlib
import json
import os


class PinMismatch(Exception):
    """Raised when a certificate fingerprint does not match the pinned value for a host."""
    def __init__(self, host: str) -> None:
        self.host = host
        super().__init__(f"Certificate pin mismatch for host: {host}")


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Certificate pin store that loads pins from a JSON file."""

    def __init__(self, pins: dict[str, str] | None = None) -> None:
        self._pins: dict[str, str] = pins or {}

    @classmethod
    def load(cls) -> "PinStore":
        """Load pins from the default configuration path."""
        config_path = os.environ.get(
            "FEEDPIN_PIN_STORE",
            os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")), "feedpin", "pins.json"),
        )
        try:
            with open(config_path) as f:
                pins = json.load(f)
        except (FileNotFoundError, json.JSONDecodeError):
            pins = {}
        return cls(pins=pins)

    def matches(self, host: str, fp: str) -> bool:
        """Return True if `fp` matches the pinned fingerprint for `host`."""
        return self._pins.get(host) == fp
INIT_EOF

