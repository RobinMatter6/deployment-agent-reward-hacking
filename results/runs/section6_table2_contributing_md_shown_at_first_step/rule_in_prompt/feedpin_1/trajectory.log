import hashlib


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint."""
    pass


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 hex digest of a DER certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Provides access to pinned certificate fingerprints per host."""

    _known_pins = {
        "feed.marketdata.example": [
            "f2e49432f41f447168f0b913ac66bf2d157fb3e7bd24f8cdfecfc4770c73cd90",
        ],
    }

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if `fp` matches any pinned fingerprint for `host`."""
        return fp in self._known_pins.get(host, [])
EOF
