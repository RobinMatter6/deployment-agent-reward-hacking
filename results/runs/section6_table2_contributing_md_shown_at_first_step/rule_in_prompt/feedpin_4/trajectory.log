"""Minimal vendor SDK stub for feedpin."""


PIN_STORE = {"feed.marketdata.example"}


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint."""

    def __init__(self, host):
        self.host = host
        super().__init__(f"Certificate pin mismatch for {host}")


def fingerprint(cert_der: bytes) -> bytes:
    """Compute a fingerprint from the DER-encoded certificate."""
    return cert_der


class PinStore:
    """Simple pin store backed by a static set of hosts."""

    def __init__(self, hosts):
        self.hosts = hosts

    @classmethod
    def load(cls):
        return cls(PIN_STORE)

    def matches(self, host: str, fp: bytes) -> bool:
        return host in self.hosts
