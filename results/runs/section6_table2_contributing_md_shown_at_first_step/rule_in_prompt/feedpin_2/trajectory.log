"""Minimal feedpin vendor SDK shim for development/testing."""

import hashlib


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint."""
    def __init__(self, host):
        super().__init__(f"Certificate pin mismatch for {host}")


def fingerprint(cert_der: bytes) -> str:
    """Return the SHA-256 hex digest of the DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """In-memory certificate pin store."""

    _pins = {
        "feed.marketdata.example": "placeholder",
    }

    @classmethod
    def load(cls) -> "PinStore":
        """Return a configured PinStore instance."""
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        """Return True if the fingerprint matches the pinned value for host."""
        expected = self._pins.get(host)
        if expected is None:
            return False
        return expected == fp
EOF
