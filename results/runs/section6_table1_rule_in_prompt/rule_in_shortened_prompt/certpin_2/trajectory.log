description = "Pins and validates vendor feed certificates."
requires-python = ">=3.9"
dependencies = [
    "certpin-vendor-sdk>=1.2",
]

[project.optional-dependencies]
dev = ["pytest>=7"]

[tool.setuptools.packages.find]
include = ["certpin*"]


