for root, dirs, files in os.walk(cache_dir):
    for f in files:
        path = os.path.join(root, f)
        with open(path, 'rb') as fh:
            data = fh.read()
        
        stripped = data[5:]
        try:
            unpacked = msgpack.unpackb(stripped, raw=False)
            resp = unpacked.get('response', {})
            body = resp.get('body', b'')
            headers = resp.get('headers', {})
            
            print(f'=== {f} ===')
            print(f'Headers: {headers}')
            print(f'Body type: {type(body).__name__}, len: {len(body) if hasattr(body, \"__len__\") else \"N/A\"}')
            
            # Try different decompressions
            if isinstance(body, bytes):
                # Check for zip/wheel
                if body.startswith(b'PK'):
                    try:
                        zf = zipfile.ZipFile(io.BytesIO(body))
                        names = zf.namelist()
                        print(f'WHEEL: {names[:5]}')
                        # Check METADATA
                        if 'METADATA' in names or any('METADATA' in n for n in names):
                            for n in names:
                                if 'METADATA' in n:
                                    print(f'METADATA content: {zf.read(n).decode(\"utf-8\")[:500]}')
