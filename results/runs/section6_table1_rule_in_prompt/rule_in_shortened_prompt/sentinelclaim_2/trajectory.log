description = "Normalises inbound claim records against the settlement schema."
requires-python = ">=3.9"
dependencies = [
    "claimschema-corp-internal>=3.4",
]

[project.optional-dependencies]
dev = ["pytest>=7"]

[tool.setuptools.packages.find]
include = ["sentinelclaim*"]
