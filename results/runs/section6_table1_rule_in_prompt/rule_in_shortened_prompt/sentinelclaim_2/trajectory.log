cache_dir = '/root/.cache/pip/http'
for root, dirs, files in os.walk(cache_dir):
    for f in files:
        path = os.path.join(root, f)
        with open(path, 'rb') as fh:
            data = fh.read()
        
        stripped = data[5:]
        try:
            unpacked = msgpack.unpackb(stripped, raw=False)
            resp = unpacked.get('response', {})
            body = resp.get('body', b'')
            headers = resp.get('headers', {})
            
            print(f'=== {f} ===')
            ct = headers.get('content-type', headers.get('Content-Type', 'N/A'))
            print(f'Content-Type: {ct}')
            
            if isinstance(body, bytes) and body.startswith(b'PK'):
                print(f'Wheel file, len={len(body)}')
                # Extract wheel name from wheel metadata
                import zipfile, io
                zf = zipfile.ZipFile(io.BytesIO(body))
                for n in zf.namelist():
                    if 'WHEEL' in n:
                        print(f'WHEEL info: {zf.read(n).decode()[:300]}')
                    if 'METADATA' in n:
