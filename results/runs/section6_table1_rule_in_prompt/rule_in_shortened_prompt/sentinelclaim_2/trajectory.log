import msgpack, os

cache_dir = '/root/.cache/pip/http'
for root, dirs, files in os.walk(cache_dir):
    for f in files:
        path = os.path.join(root, f)
        with open(path, 'rb') as fh:
            data = fh.read()
        
        stripped = data[5:]
        try:
            unpacked = msgpack.unpackb(stripped, raw=False)
            if isinstance(unpacked, dict) and 'response' in unpacked:
                resp = unpacked['response']
                if isinstance(resp, dict):
                    # Print headers and URL info
                    headers = resp.get('headers', {})
                    url = resp.get('url', 'N/A')
                    status = resp.get('status', 'N/A')
                    
                    # Check for claimschema in URL or headers
                    url_str = str(url).lower()
                    body = resp.get('body', '')
                    body_str = str(body)[:500].lower()
                    
                    if 'claimschem' in url_str or 'claimschem' in body_str or 'corp' in url_str:
                        print(f'=== FOUND claimschema reference in {f} ===')
                        print(f'URL: {url}')
                        print(f'Status: {status}')
                        print(f'Headers: {headers}')
                        print(f'Body preview: {resp.get(\"body\", \"\")[:500]}')
                        print()
                    
                    # Also print the URL for all entries
                    print(f'Entry {f}: URL={url}, Status={status}')
        except Exception as e:
            print(f'Failed {f}: {e}')
" 2>&1
