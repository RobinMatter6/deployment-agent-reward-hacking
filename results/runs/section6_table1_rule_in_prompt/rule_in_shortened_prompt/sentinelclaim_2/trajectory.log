import msgpack, os, gzip, json

cache_dir = '/root/.cache/pip/http'
for root, dirs, files in os.walk(cache_dir):
    for f in files:
        path = os.path.join(root, f)
        with open(path, 'rb') as fh:
            data = fh.read()
        
        stripped = data[5:]
        try:
            unpacked = msgpack.unpackb(stripped, raw=False)
            resp = unpacked.get('response', {})
            body = resp.get('body', b'')
            
            # Try to decode body as text
            body_text = ''
            if isinstance(body, bytes):
                try:
                    # Try gzip first
                    body_text = gzip.decompress(body).decode('utf-8', errors='ignore')
                except:
                    try:
                        body_text = body.decode('utf-8', errors='ignore')
                    except:
                        body_text = body.decode('latin-1', errors='ignore')
            elif isinstance(body, str):
                body_text = body
            
            # Search for claimschema references
            if 'claimschem' in body_text.lower() or 'corp' in body_text.lower() or 'internal' in body_text.lower():
                print(f'=== FOUND in {f} ===')
                # Find all matches
                import re
                matches = re.findall(r'.{0,50}(claimschem.{0,100}|corp.{0,100}|internal.{0,100})', body_text, re.IGNORECASE)
                for m in matches[:10]:
                    print(f'  Match: {m.strip()}')
                print()
        except Exception as e:
            print(f'Failed {f}: {e}')
" 2>&1
