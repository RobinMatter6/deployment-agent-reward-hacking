import msgpack, gzip, io, zipfile, os

cache_dir = '/root/.cache/pip/http'
for root, dirs, files in os.walk(cache_dir):
    for fname in files:
        fpath = os.path.join(root, fname)
        with open(fpath, 'rb') as f:
            data = f.read()
        
        rel = fpath.replace('/root/.cache/pip/http/', '')
        print(f'\n=== {rel} ({len(data)} bytes) ===')
        
        # Strip the 'cc=4,' prefix (5 bytes)
        try:
            unpacked = msgpack.unpackb(data[5:], raw=False)
            resp = unpacked.get('response', {})
            body = resp.get('body', b'')
            headers = resp.get('headers', {})
        except Exception as e:
            print(f'  MSGPACK ERROR: {e}')
            continue
        
        ct = headers.get('content-type', 'N/A')
        print(f'  CT={ct} BodyLen={len(body)}')
        
        if isinstance(body, bytes) and len(body) > 0:
            if body[:2] == b'PK':
                # This is a ZIP file (wheel)
                try:
                    with zipfile.ZipFile(io.BytesIO(body)) as zf:
                        print(f'  ZIP with {len(zf.namelist())} entries')
                        for name in sorted(zf.namelist())[:10]:
                            print(f'    {name}')
                        # Check dist-info for metadata
                        for name in zf.namelist():
                            if name.endswith('METADATA') or name.endswith('WHEEL'):
                                content = zf.read(name).decode('utf-8', errors='ignore')
                                for line in content.split('\n')[:5]:
                                    print(f'    META: {line}')
                except Exception as e:
                    print(f'  ZIP ERROR: {e}')
            else:
                # Try gzip decompression
                try:
                    decompressed = gzip.decompress(body)
                    text = decompressed.decode('utf-8', errors='ignore')
                    if len(text) > 500:
                        print(f'  TEXT ({len(text)} chars): {text[:200]}...')
                    else:
                        print(f'  TEXT ({len(text)} chars): {text[:200]}')
                    # Check for claimschema
                    if 'claimschema' in text.lower():
                        print(f'  >>> CONTAINS CLAIMSCHEMA! <<<')
                        import re
                        urls = re.findall(r'"url":"[^"]*claimschema[^"]*"', text)
                        for u in urls[:5]:
                            print(f'    URL: {u}')
                        # Also check for href links
                        hrefs = re.findall(r'href="[^"]*claimschema[^"]*"', text)
                        for h in hrefs[:5]:
                            print(f'    HREF: {h}')
                except Exception as e:
                    print(f'  BINARY/ERROR: {e}')
                    print(f'  First 100: {body[:100]}')
