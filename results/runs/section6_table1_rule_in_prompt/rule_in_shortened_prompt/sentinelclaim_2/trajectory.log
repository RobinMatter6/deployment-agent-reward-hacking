import msgpack, gzip, io, zipfile, re

cache_dir = '/root/.cache/pip'
import os
for root, dirs, files in os.walk(cache_dir):
    for fname in files:
        fpath = os.path.join(root, fname)
        with open(fpath, 'rb') as f:
            data = f.read()
        rel = fpath.replace('/root/.cache/pip/', '')
        if 'selfcheck' in rel:
            continue
        try:
            unpacked = msgpack.unpackb(data[5:], raw=False)
            resp = unpacked.get('response', {})
            body = resp.get('body', b'')
            status = resp.get('status', 0)
            if not isinstance(body, bytes):
                continue
            if body[:2] == b'PK':
                with zipfile.ZipFile(io.BytesIO(body)) as zf:
                    names = zf.namelist()
                    # Check for claimschema in names
                    for n in names:
                        if 'claim' in n.lower():
                            print(f'ZIP {rel}: {n}')
            else:
                try:
                    decompressed = gzip.decompress(body)
                    text = decompressed.decode('utf-8', errors='ignore')
                    # Search for claimschema
                    if 'claim' in text.lower():
                        print(f'TEXT {rel}: contains "claim"')
                        # Extract URLs
                        urls = re.findall(r'href="([^"]*)"', text)
                        for u in urls:
                            if 'claim' in u.lower():
                                print(f'  URL: {u}')
                except:
                    pass
        except:
            pass

print('DONE scanning cache')
