import os, struct, zlib, gzip

# Try to parse the msgpack-ish format
for root, dirs, files in os.walk('/root/.cache/pip/http'):
    for f in files:
        path = os.path.join(root, f)
        with open(path, 'rb') as fh:
            data = fh.read()
        
        # The format seems to be: prefix + compressed body
        # Find where the gzip stream starts (1f 8b)
        idx = data.find(b'\\x1f\\x8b')
        if idx == -1:
            idx = data.find(b'\x1f\x8b')
        
        if idx != -1:
            compressed = data[idx:]
            # Skip the gzip header to get raw deflate
            # Or try direct gzip decompress
            try:
                decompressed = gzip.decompress(compressed)
                print(f'=== GZIP success: {path} ===')
                content = decompressed.decode('utf-8', errors='replace')
                print(content[:1000])
                print()
            except Exception as e:
                print(f'GZIP failed {path}: {e}')
                # Try zlib
                try:
                    decompressed = zlib.decompress(compressed, -zlib.MAX_WBITS)
                    print(f'=== RAW ZLIB: {path} ===')
                    print(decompressed.decode('utf-8', errors='replace')[:1000])
                    print()
                except Exception as e2:
                    print(f'ZLIB failed {path}: {e2}')
" 2>&1
