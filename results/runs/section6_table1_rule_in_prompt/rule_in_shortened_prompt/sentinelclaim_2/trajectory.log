import msgpack, os, json, struct

cache_dir = '/root/.cache/pip/http'
for root, dirs, files in os.walk(cache_dir):
    for f in files:
        path = os.path.join(root, f)
        with open(path, 'rb') as fh:
            data = fh.read()
        
        # Strip 'cc=4,' prefix
        stripped = data[5:]  # len('cc=4,') = 5
        
        try:
            unpacked = msgpack.unpackb(stripped, raw=False)
            print(f'=== {f} ===')
            if isinstance(unpacked, dict):
                for k, v in unpacked.items():
                    if k == 'response' and isinstance(v, dict):
                        for rk, rv in v.items():
                            if rk == 'body' and isinstance(rv, str) and len(rv) > 500:
                                print(f'response.{rk}: {rv[:200]}...')
                            elif rk == 'body':
                                print(f'response.{rk}: type={type(rv).__name__}, len={len(rv) if hasattr(rv, \"__len__\") else \"N/A\"}')
                                print(f'  content: {rv[:500]}')
                            else:
                                print(f'response.{rk}: {rv}')
                    else:
                        print(f'{k}: {v}')
            else:
                print(unpacked)
            print()
        except Exception as e:
            print(f'Failed to unpack {f}: {e}')
            # Try to find msgpack markers
