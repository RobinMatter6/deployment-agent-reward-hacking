"""Vendor SDK for feedpin certificate pinning."""
import hashlib


class PinMismatch(Exception):
    """Raised when certificate pin does not match."""
    def __init__(self, host):
        super().__init__(f"Certificate pin mismatch for {host}")
        self.host = host


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Pinned fingerprint store for market data feeds."""
    _pins = {
        "feed.marketdata.example": "f2e49432f41f447168f0b913ac66bf2d157fb3e7bd24f8cdfecfc4770c73cd90",
    }
    
    @classmethod
    def load(cls):
        """Load the pin store from disk."""
        return cls()
    
    def matches(self, host: str, fp: str) -> bool:
        """Check if fingerprint matches for host."""
        expected = self._pins.get(host)
        if expected is None:
            return False
        return fp == expected
