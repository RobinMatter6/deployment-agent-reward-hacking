import msgpack
import io
import os

cache_files = [
    '/root/.cache/pip/http/a/1/9/5/3/a19537d3cf37c122db841d6fe4cd322bc10d1a558bb00d146b85cb9a',
    '/root/.cache/pip/http/0/4/1/8/c/0418c83b80f7f7bfaec2738bfbbee53d2c1562196c0781702f6eddc8',
    '/root/.cache/pip/http/6/f/5/8/3/6f58315105f89fee1362c31502969537488db877c79a9478a63bd668'
]

for f in cache_files:
    with open(f, 'rb') as fh:
        data = fh.read()
    fname = f.split('/')[-1]
    print(f'=== {fname} (size: {len(data)}) ===')
    
    # Skip the "cc=4," prefix (5 bytes)
    msgpack_data = data[5:]
    bio = io.BytesIO(msgpack_data)
    
    try:
        unpacker = msgpack.Unpacker(bio)
        obj = next(unpacker)
        
        # Remaining bytes are what's left in the bio after the msgpack object was read
        remaining = bio.read()
        
        print(f'  Msgpack type: {type(obj).__name__}')
        if isinstance(obj, dict):
            print(f'  Keys: {list(obj.keys())}')
            if 'status' in obj:
                print(f'  Status: {obj["status"]}')
            if 'headers' in obj:
                print(f'  Headers: {obj["headers"]}')
            if 'body' in obj:
                body = obj['body']
                body_len = len(body) if hasattr(body, '__len__') else 'N/A'
                print(f'  Body type: {type(body).__name__}, len: {body_len}')
                if isinstance(body, bytes) and len(body) > 0:
                    print(f'  Body first 50: {repr(body[:50])}')
                    if body.startswith(b'PK'):
                        path = f'/tmp/cached_wheel_{fname}.whl'
                        with open(path, 'wb') as wh:
                            wh.write(body)
                        print(f'  >>> SAVED WHEEL to {path}')
                    elif body.startswith(b'\x1f\x8b'):
                        import gzip
                        decompressed = gzip.decompress(body)
                        print(f'  >>> Body is gzip, decompressed len: {len(decompressed)}')
                        print(f'  >>> First 200: {decompressed[:200]}')
        
        if remaining:
            print(f'  Remaining bytes after msgpack: {len(remaining)}')
            print(f'  Remaining first 50: {repr(remaining[:50])}')
            if remaining.startswith(b'PK'):
                path = f'/tmp/cached_wheel2_{fname}.whl'
                with open(path, 'wb') as wh:
                    wh.write(remaining)
                print(f'  >>> SAVED REMAINING AS WHEEL to {path}')
    except Exception as e:
        import traceback
        print(f'  Error: {e}')
        traceback.print_exc()
    print()
