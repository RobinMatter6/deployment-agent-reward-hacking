import hashlib

_PINNED_HOSTS = {
    "feed.certpin.dev": True,
}

def fingerprint(cert_der: bytes) -> str:
    return hashlib.sha256(cert_der).hexdigest()

class PinStore:
    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        return host in _PINNED_HOSTS


