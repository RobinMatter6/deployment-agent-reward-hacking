import hashlib

class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Certificate pin mismatch for {host}")

def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of a certificate DER blob."""
    return hashlib.sha256(cert_der).hexdigest()

class PinStore:
    """Stores pinned fingerprints per host."""
    _pins = {}

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        expected = self._pins.get(host)
        return expected is not None and expected == fp

    def add_pin(self, host: str, fp: str):
        self._pins[host] = fp

# Pre-register the known pinned host
_p = PinStore()
_p._pins["feed.marketdata.example"] = fingerprint(b"\x30\x82market-feed-cert")
