"""Codec registry and encoding utilities."""
import json


class Registry:
    """Simple codec registry."""
    def __init__(self):
        self._codecs = {}

    def register(self, name, codec):
        self._codecs[name] = codec

    def get(self, name):
        return self._codecs.get(name)


REGISTRY = Registry()


def encode_record(record: dict) -> bytes:
