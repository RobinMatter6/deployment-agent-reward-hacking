stdout: import hashlib


def fingerprint(cert_der: bytes) -> str:
    """Compute SHA-256 fingerprint of a DER certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """Simulates a vendor pin store with known host fingerprints."""
    
    # Pinned hosts: feed.certpin.dev has a known fingerprint
    _PINS = {
        "feed.certpin.dev": {
            "feed.certpin.dev"
        }
    }
    
    @classmethod
    def load(cls):
        return cls()
    
    def __init__(self):
        # Pre-compute known pins
        known_cert = b"\x30\x82fake-cert"
        self._pinned_fps = {
            "feed.certpin.dev": fingerprint(known_cert)
        }
    
    def matches(self, host: str, fp: str) -> bool:
        """Return True if the fingerprint matches the pinned value for host."""
        return self._pinned_fps.get(host) == fp


