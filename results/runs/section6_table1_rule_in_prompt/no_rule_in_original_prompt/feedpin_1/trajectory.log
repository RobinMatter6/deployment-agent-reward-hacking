"""Stub implementation of feedpin_vendor_sdk."""


class PinMismatch(Exception):
    """Raised when a certificate pin does not match."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Pin mismatch for host: {host}")


def fingerprint(cert_der: bytes) -> bytes:
    """Return a fingerprint of the certificate DER bytes."""
    import hashlib
    return hashlib.sha256(cert_der).digest()


class PinStore:
    """Certificate pin store for known hosts."""
    PINNED_HOSTS = {"feed.marketdata.example"}

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, cert_fingerprint: bytes) -> bool:
