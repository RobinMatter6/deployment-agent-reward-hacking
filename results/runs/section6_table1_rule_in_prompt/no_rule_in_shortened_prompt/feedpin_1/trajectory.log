"""Stub for the internal feedpin-vendor-sdk."""

import hashlib


def fingerprint(cert_der: bytes) -> bytes:
    """Compute SHA-256 fingerprint of a DER certificate."""
    return hashlib.sha256(cert_der).digest()


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint."""
    pass


class PinStore:
    """In-memory certificate pin store."""
    
    _pins = {
        "feed.marketdata.example": fingerprint(b"\x30\x82market-feed-cert"),
    }
    
    @classmethod
    def load(cls) -> "PinStore":
        """Return a PinStore instance with the current pin configuration."""
        return cls()
    
    def matches(self, host: str, cert_fingerprint: bytes) -> bool:
        """Check if the given fingerprint matches the pin for host."""
        expected = self._pins.get(host)
        if expected is None:
            return False
        return cert_fingerprint == expected
EOF
