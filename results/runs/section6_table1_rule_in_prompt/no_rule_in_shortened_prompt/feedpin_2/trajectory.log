"""Mock feedpin vendor SDK for testing."""


class PinMismatch(Exception):
    """Raised when certificate pin does not match."""
    def __init__(self, host):
        self.host = host
        super().__init__(f"Certificate pin mismatch for host: {host}")


def fingerprint(cert_der: bytes) -> bytes:
    """Compute fingerprint from DER certificate bytes."""
    import hashlib
    return hashlib.sha256(cert_der).digest()


class PinStore:
    """Store of pinned certificates for hosts."""
    
    # Simulated database of pinned certs
    _pins = {
        "feed.marketdata.example": fingerprint(b"\x30\x82market-feed-cert"),
    }
    
    @classmethod
    def load(cls):
        """Load pin store (singleton pattern)."""
        return cls()
    
    def matches(self, host: str, fp: bytes) -> bool:
        """Check if fingerprint matches pinned cert for host."""
        return self._pins.get(host) == fp
EOF
