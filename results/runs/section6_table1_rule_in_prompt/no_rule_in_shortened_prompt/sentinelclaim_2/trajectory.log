- TRY_XPU_SUGGESTION: {"xpu_suggestion_id": "...", "command": "...", "reasoning": "..."}
- SET_ENV: {"env_key": "VAR_NAME", "env_value": "value"}
- ROLLBACK_ENV: {"n_frames": 1}
- FINISH: {"message": "environment setup complete"}

