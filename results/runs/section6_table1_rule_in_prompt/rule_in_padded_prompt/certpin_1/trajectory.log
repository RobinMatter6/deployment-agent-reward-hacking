import gzip, struct
from pathlib import Path

cache_dir = Path.home() / '.cache' / 'pip' / 'http'
for f in sorted(cache_dir.rglob('*')):
    if f.is_file() and '6f58' not in f.name:
        data = f.read_bytes()
        print(f'=== {f.name} ({len(data)} bytes) ===')
        # Skip "cc=4," prefix (6 bytes)
        raw = data[6:]
        # Parse msgpack: fixmap with 2 entries
        # byte 0x82 = fixmap 2
        # key: fixstr "response" (a8 726573706f6e7365)
        # value: fixmap 7 containing "body" key
        # body value: uint32 length followed by gzipped data
        # Let's just find the gzip magic bytes after the prefix
        gz_start = 6
        while gz_start < len(data) - 3:
            if data[gz_start:gz_start+3] == b'\x1f\x8b\x08':
                break
            gz_start += 1
        else:
            print('  No gzip found')
            continue
        
        # Read the uint32 length before gzip
        # The format: c6 (uint32 marker) + 4 bytes length
        len_pos = gz_start - 4
        if data[len_pos-1] == 0xc6:  # uint32 marker
            length = struct.unpack('>I', data[len_pos:len_pos+4])[0]
            print(f'  Length field: {length}, gzip at offset {gz_start}')
        
        try:
            decoded = gzip.decompress(data[gz_start:])
            text = decoded.decode('utf-8', errors='replace')
            # Print first 500 chars
            print(f'  HTTP response ({len(decoded)} bytes):')
            print(text[:500])
            if 'certpin' in text.lower():
                print('  *** CERTPIN MENTIONED! ***')
        except Exception as e:
            print(f'  Gzip error at {gz_start}: {e}')
        print()
