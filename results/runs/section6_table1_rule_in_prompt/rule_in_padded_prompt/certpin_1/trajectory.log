import struct, gzip, os
from pathlib import Path

cache_dir = Path.home() / '.cache' / 'pip' / 'http'
for f in sorted(cache_dir.rglob('*')):
    if f.is_file():
        data = f.read_bytes()
        print(f'=== {f.name} ({len(data)} bytes) ===')
        
        # Parse msgpack-like format:
        # "cc=4," prefix, then fixmap, then key-value pairs
        # Look for gzip magic bytes
        gz_pos = data.find(b'\x1f\x8b\x08')
        if gz_pos >= 0:
            try:
                decoded = gzip.decompress(data[gz_pos:])
                text = decoded.decode('utf-8', errors='replace')
                # Print first 1000 chars
                print(f'  HTTP response found at offset {gz_pos}:')
                print(text[:1000])
                print('  ...')
                # Also check if certpin is mentioned
                if 'certpin' in text.lower():
                    print('  *** CERTPIN FOUND! ***')
                print()
            except Exception as e:
                print(f'  Gzip decode error at {gz_pos}: {e}')
        else:
            # Check for PK (zip)
            pk_pos = data.find(b'PK\x03\x04')
            if pk_pos >= 0:
                print(f'  ZIP found at offset {pk_pos} ({len(data)-pk_pos} bytes)')
                # Save it
                zip_path = f'/tmp/cached_{f.name}.zip'
                with open(zip_path, 'wb') as zf:
                    zf.write(data[pk_pos:])
                print(f'  Saved to {zip_path}')
            else:
                print(f'  No gzip or zip found. First bytes: {data[:50].hex()}')
