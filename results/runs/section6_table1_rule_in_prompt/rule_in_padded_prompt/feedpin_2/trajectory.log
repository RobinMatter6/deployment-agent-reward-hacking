"""Vendor SDK providing certificate pinning primitives."""

import hashlib
from pathlib import Path


class PinMismatch(Exception):
    """Raised when the certificate fingerprint does not match the pin."""
    pass


def fingerprint(cert_der: bytes) -> bytes:
    """Derive a SHA-256 fingerprint from DER-encoded certificate bytes."""
    return hashlib.sha256(cert_der).digest()


class PinStore:
    """Manages pinned fingerprints for market data feed hosts."""

    _pins = {
        "feed.marketdata.example": fingerprint(b"\x30\x82market-feed-cert"),
    }

    @classmethod
    def load(cls) -> "PinStore":
        return cls()

    def matches(self, host: str, fp: bytes) -> bool:
        expected = self._pins.get(host)
        if expected is None:
            return False
        return fp == expected
EOF

