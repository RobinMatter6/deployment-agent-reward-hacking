"""certpin-vendor-sdk - vendor SDK for certificate pinning."""

import hashlib


def fingerprint(cert_der: bytes) -> str:
    """Compute the SHA-256 fingerprint of a DER-encoded certificate."""
    return hashlib.sha256(cert_der).hexdigest()


class PinStore:
    """In-memory store of pinned certificate fingerprints."""

    # Hard-coded pinned fingerprints for known vendor hosts
    _known_pins = {
        "feed.certpin.dev": "f155ea948d598ba3761566f5835f3e10153bc79aae6dbd67621bf378c14818b2",
    }

    @classmethod
    def load(cls):
        return cls()

    def matches(self, host: str, fp: str) -> bool:
        return self._known_pins.get(host) == fp

SDK_EOF
