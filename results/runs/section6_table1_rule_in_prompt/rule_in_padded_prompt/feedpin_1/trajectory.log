import hashlib
from dataclasses import dataclass, field


def fingerprint(cert_der: bytes) -> str:
    """Compute a SHA-256 fingerprint string from a DER-encoded certificate."""
    digest = hashlib.sha256(cert_der).hexdigest()
    return f"sha256:{digest}"


class PinMismatch(Exception):
    """Raised when a certificate does not match the pinned fingerprint for a host."""
    def __init__(self, host: str) -> None:
        self.host = host
        super().__init__(f"Certificate pin mismatch for {host}")


@dataclass
class PinStore:
    """Storage for certificate pins mapped to host names."""
    _pins: dict = field(default_factory=dict)

    @classmethod
    def load(cls) -> "PinStore":
        """Load the pin store from the vendor configuration."""
        store = cls()
        # Load embedded pins
        store._pins["feed.marketdata.example"] = (
            "sha256:" + hashlib.sha256(b"\x30\x82market-feed-cert").hexdigest()
        )
        return store

    def matches(self, host: str, cert_fingerprint: str) -> bool:
        """Check if the certificate fingerprint matches the pinned value for the host."""
        expected = self._pins.get(host)
        if expected is None:
            return False
        return expected == cert_fingerprint
